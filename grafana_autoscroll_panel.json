        "content": "\r\n\r\n    <button id=\"MyAutoScroll\" style=\"height: 100%; width: 100%;\" onclick=\"toggleScroll()\">\r\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 384 512\" height=\"100%\"><!--! Font Awesome Free 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80V432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z\"/></svg> </button>\r\n\r\n    <div>\r\n        <br>\r\n    <span id=\"Scroll_Waiting\">second Before AutoPlay : </span>\r\n    <br>\r\n    <span id=\"Scroll_default\">Default autoPlay Value :  </span>\r\n    <br>\r\n    <span id=\"Scroll_px\">scrolling px /Speed /Step : </span>\r\n    <br>\r\n    <span id=\"Scroll_delay\">Scrolling delay in (s) : </span>\r\n    <br>\r\n    <span id=\"Scroll_inv_delay\">delay before inverting scrolling direction : </span>\r\n\r\n</div>\r\n    <script>\r\nvar Scroll_Waiting=45000;\r\nvar Scroll_delay= 8000;\r\nvar Scroll_inv_delay =1000;\r\nvar scrolldelay = null\r\nvar totalHeight = 0;\r\nvar distance = 250;\r\nvar scrollState=false\r\ndocument.getElementById(\"Scroll_Waiting\").innerHTML+= Scroll_Waiting\r\n    document.getElementById(\"Scroll_default\").innerHTML+= scrollState\r\n    document.getElementById(\"Scroll_px\").innerHTML+= distance\r\n    document.getElementById(\"Scroll_delay\").innerHTML+= Scroll_delay\r\n    document.getElementById(\"Scroll_inv_delay\").innerHTML+= Scroll_inv_delay\r\n\t\tvar sens=true;\r\n\t    var height_px = document.getElementsByClassName('react-grid-layout')[0].getBoundingClientRect().bottom;\r\n        \r\n        var scrollableEl = document.querySelector('.view') || document.querySelector('.scrollbar-view');\r\n        function pageScroll(scroll) {\r\n            if (scroll === true) {\r\n               \r\n            var scrollHeight = height_px;\r\n          if (totalHeight >= scrollHeight ) { \r\n                if(document.getElementsByClassName('react-grid-layout')[0].getBoundingClientRect().bottom != height_px)\r\n                {\r\n                    height_px = document.getElementsByClassName('react-grid-layout')[0].getBoundingClientRect().bottom;\r\n                }\r\n                else\r\n                {\r\n                    sens=!sens\r\n                    sleep(Scroll_inv_delay);\r\n                }\r\n            \r\n            }\r\n           \r\n\t\t\tif(sens)\r\n            {\r\n              scrollableEl.scrollBy({\r\n              top: distance,\r\n              left: 0,\r\n              behavior: 'smooth'\r\n            });\r\n              totalHeight += distance;\r\n              }\r\n\t\t\telse\r\n            {\r\n              scrollableEl.scrollBy({\r\n              top: -distance,\r\n              left: 0,\r\n              behavior: 'smooth'\r\n            });\r\n              totalHeight -= distance;\r\n              }\r\n           // console.log('totalHeight', totalHeight)\r\n\r\n            \r\n            if (totalHeight<=0) {\r\n               \r\n                sens=!sens\r\n                sleep(Scroll_inv_delay);\r\n            }\r\n                scrolldelay = setTimeout(function () {\r\n                    pageScroll(true);\r\n                }, Scroll_delay);\r\n            } else {\r\n                clearTimeout(scrolldelay);\r\n                return;\r\n            }\r\n        }\r\n        if (!document.getElementById('playButton')) {\r\n                if(document.getElementsByClassName('css-ztq7l5')[0])\r\n                { \r\n                document.getElementsByClassName('css-ztq7l5')[0].insertAdjacentHTML('afterbegin',\r\n                `<div style=\"order: -1; visibility: visible;\" class=\"css-exd1zr\"><button id=\"playButton\" onclick=\"toggleScroll()\" class=\"css-1mrmgpk-toggle-button\" aria-label=\"toggle autoPlay\" tabindex=\"0\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 384 512\" width=\"18\" height=\"18\" class=\"css-1d3xu67-Icon\"><!--! Font Awesome Free 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80V432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z\"/></svg></button></div>`)\r\n                \r\n                }\r\n               \r\n          \r\n        }\r\nsleep(Scroll_Waiting); // wait 45s before starting to allow user to change param\r\n\r\n setInterval(function () {\r\n        if (!scrollState) {\r\n            //console.log(\"Variable AutoScroll value change\")\r\n            if((visualViewport.width !=1200\r\n) && (new URLSearchParams(window.location.search)).get('kiosk')!=null)\r\n            {\r\n            toggleScroll()\r\n            }\r\n            \r\n        }\r\n              }, 10000); // Checks every 10s(0.1s)\r\n\r\n//toggleScroll();\r\n/*\r\nsetInterval(function () {\r\n        if (scrollState!=${autoscroll}) {\r\n            console.log(\"Variable AutoScroll value change\")\r\n            toggleScroll()\r\n        }\r\n              }, 10000); // Checks every 10s(0.1s)\r\n*/        \r\n                   function toggleScroll() {\r\n            scrollState=!scrollState\r\n            if (scrollState) {\r\n                document.getElementById('MyAutoScroll').innerHTML=`<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\" height=\"100%\"><!--! Font Awesome Free 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M48 64C21.5 64 0 85.5 0 112V400c0 26.5 21.5 48 48 48H80c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48H48zm192 0c-2