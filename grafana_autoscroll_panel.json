        "content": "\n\n    <button id=\"MyAutoScroll\" style=\"height: 100%; width: 100%;\" onclick=\"toggleScroll()\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 384 512\" height=\"100%\"><!--! Font Awesome Free 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80V432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z\"/></svg> </button>\n\n    <div>\n        <br>\n    <span id=\"Scroll_Waiting\">seconds before autoplay: </span>\n    <br>\n    <span id=\"Scroll_default\">default autoplay state: </span>\n    <br>\n    <span id=\"Scroll_px\">scroll step (px): </span>\n    <br>\n    <span id=\"Scroll_delay\">delay between steps (ms): </span>\n    <br>\n    <span id=\"Scroll_inv_delay\">delay before reversing direction (ms): </span>\n</div>\n    <script>\n(function () {\n  // --- Configuration ---\n  // Edit the fallback numbers below to change default behavior, or override\n  // per-dashboard without touching this panel: add a dashboard template\n  // variable named e.g. \"autoscroll_wait_ms\" and Grafana will automatically\n  // put \"var-autoscroll_wait_ms=<value>\" on the URL, which this script reads.\n  // Dashboards that don't define these variables are unaffected.\n  function getVarOverride(name, fallback) {\n    var params = new URLSearchParams(window.location.search);\n    var raw = params.get('var-' + name);\n    var num = raw !== null ? Number(raw) : NaN;\n    return isNaN(num) ? fallback : num;\n  }\n\n  var Scroll_Waiting = getVarOverride('autoscroll_wait_ms', 45000);\n  var Scroll_delay = getVarOverride('autoscroll_delay_ms', 8000);\n  var distance = getVarOverride('autoscroll_distance_px', 250);\n  var Scroll_inv_delay = getVarOverride('autoscroll_invert_delay_ms', 1000);\n  var scrollState = false;\n  var sens = true;\n  var running = false;\n\n  document.getElementById('Scroll_Waiting').innerHTML += Scroll_Waiting;\n  document.getElementById('Scroll_default').innerHTML += scrollState;\n  document.getElementById('Scroll_px').innerHTML += distance;\n  document.getElementById('Scroll_delay').innerHTML += Scroll_delay;\n  document.getElementById('Scroll_inv_delay').innerHTML += Scroll_inv_delay;\n\n  function sleep(ms) {\n    return new Promise(function (resolve) { setTimeout(resolve, ms); });\n  }\n\n  // Grafana's dashboard-grid/scroll-container DOM has changed across\n  // versions (pre-Scenes vs Grafana 10+ Scenes architecture). The old\n  // \".view\"/\".scrollbar-view\" custom-scrollbar classes no longer exist on\n  // current Grafana - it scrolls the document itself now. Try the legacy\n  // classes first (older Grafana), then fall back to native document\n  // scrolling, which is what current Grafana actually uses.\n  function getScrollContainer() {\n    return document.querySelector('.view')\n      || document.querySelector('.scrollbar-view')\n      || document.scrollingElement\n      || document.documentElement;\n  }\n\n  async function pageScrollLoop() {\n    running = true;\n    while (scrollState) {\n      var container = getScrollContainer();\n      var max = Math.max(0, container.scrollHeight - container.clientHeight);\n      if (max <= 0) {\n        // nothing to scroll (short dashboard, or container not found this tick) - idle and re-check\n        await sleep(Scroll_delay);\n        continue;\n      }\n      var current = container.scrollTop;\n      if (sens && current >= max) {\n        sens = false;\n        await sleep(Scroll_inv_delay);\n        if (!scrollState) break;\n      } else if (!sens && current <= 0) {\n        sens = true;\n        await sleep(Scroll_inv_delay);\n        if (!scrollState) break;\n      }\n      container.scrollBy({ top: sens ? distance : -distance, left: 0, behavior: 'smooth' });\n      await sleep(Scroll_delay);\n    }\n    running = false;\n  }\n\n  var ICON_PLAY = '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 384 512\" %SIZE%><!--! Font Awesome Free 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80V432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z\"/></svg>';\n  var ICON_PAUSE = '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\" %SIZE%><!--! Font Awesome Free 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M48 64C21.5 64 0 85.5 0 112V400c0 26.5 21.5 48 48 48H80c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48H48zm192 0c-26.5 0-48 21.5-48 48V400c0 26.5 21.5 48 48 48h32c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48H240z\"/></svg>';\n\n  function setButtonIcon(playing) {\n    var icon = playing ? ICON_PAUSE : ICON_PLAY;\n    document.getElementById('MyAutoScroll').innerHTML = icon.replace('%SIZE%', 'height=\"100%\"');\n    var playButton = document.getElementById('playButton');\n    if (playButton) playButton.innerHTML = icon.replace('%SIZE%', 'width=\"18\" height=\"18\" class=\"css-1d3xu67-Icon\"');\n  }\n\n  function toggleScroll() {\n    scrollState = !scrollState;\n    setButtonIcon(scrollState);\n    if (scrollState && !running) pageScrollLoop();\n  }\n  window.toggleScroll = toggleScroll;\n\n  // Optional manual toggle injected into Grafana's kiosk toolbar. This class\n  // name is an internal Grafana build artifact (Emotion CSS-in-JS) that\n  // changes between versions/builds - skip silently instead of throwing if\n  // it's not found (and note kiosk mode normally hides the toolbar anyway,\n  // so this is mainly useful while editing/previewing, not in real kiosk use).\n  if (!document.getElementById('playButton')) {\n    var toolbarHost = document.getElementsByClassName('css-ztq7l5')[0];\n    if (toolbarHost) {\n      toolbarHost.insertAdjacentHTML('afterbegin',\n        '<div style=\"order: -1; visibility: visible;\" class=\"css-exd1zr\"><button id=\"playButton\" onclick=\"toggleScroll()\" class=\"css-1mrmgpk-toggle-button\" aria-label=\"toggle autoPlay\" tabindex=\"0\"></button></div>');\n      setButtonIcon(scrollState);\n    }\n  }\n\n  // Auto-start after Scroll_Waiting ms if left alone in kiosk mode (heuristic:\n  // viewport width != 1200, which is what the panel editor preview uses -\n  // kept from the original design). The wait is now a real delay since this\n  // runs inside an async IIFE instead of a fire-and-forget sleep() call.\n  (async function initAutoTrigger() {\n    await sleep(Scroll_Waiting);\n    setInterval(function () {\n      if (!scrollState\n        && visualViewport.width !== 1200\n        && new URLSearchParams(window.location.search).get('kiosk') !== null) {\n        toggleScroll();\n      }\n    }, 10000);\n  })();\n})();\n    </script>\n",
