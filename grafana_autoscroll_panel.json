.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z\"/></svg>`;\r\n                }\r\n                pageScroll(false);\r\n            }\r\n        }\r\n       \r\n        function sleep(time) {\r\n            return new Promise((resolve) => setTimeout(resolve, time));\r\n        }\r\n        /*\r\n         function sleep(num) {\r\n                let now = new Date();\r\n                const stop = now.getTime() + num;\r\n                while(true) {\r\n                now = new Date();\r\n                if(now.getTime() > stop) return;\r\n                }\r\n            }\r\n            */\r\n    </script>\r\n",
