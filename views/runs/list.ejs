<%- include('../partials/header', { title: 'Run history', active: 'runs' }) %>
<div class="toolbar">
  <h1>Run History<% if (job) { %> — <%= job.name %><% } %></h1>
</div>

<form class="filter-bar" method="get" action="/runs">
  <select name="job">
    <option value="">All jobs</option>
    <% jobs.forEach(function(j) { %>
      <option value="<%= j.id %>" <%= String(jobId) === String(j.id) ? 'selected' : '' %>><%= j.name %></option>
    <% }) %>
  </select>
  <select name="status">
    <option value="">All statuses</option>
    <% ['running','success','partial','error'].forEach(function(s) { %>
      <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <button class="btn small" type="submit">Filter</button>
  <a class="btn small" href="/runs">Clear</a>
</form>

<table>
  <thead>
    <tr><th>Job</th><th>Trigger</th><th>Started</th><th>Finished</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% runs.forEach(function(r) { %>
    <tr>
      <td><a href="/jobs/<%= r.job_id %>"><%= r.job_name || r.job_id %></a></td>
      <td><%= r.trigger_type %></td>
      <td><%= new Date(r.started_at).toLocaleString() %></td>
      <td><%= r.finished_at ? new Date(r.finished_at).toLocaleString() : '—' %></td>
      <td><span class="status <%= r.status %>"><%= r.status %></span></td>
      <td><a class="btn small" href="/runs/<%= r.id %>">Details</a></td>
    </tr>
    <% }) %>
    <% if (!runs.length) { %>
      <tr><td colspan="6" class="muted">No runs match this filter.</td></tr>
    <% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
