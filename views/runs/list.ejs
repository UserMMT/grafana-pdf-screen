<%- include('../partials/header', { title: 'Run history', active: 'runs' }) %>
<div class="toolbar">
  <h1>Run History<% if (job) { %> — <%= job.name %><% } %></h1>
  <% if (job) { %><a class="btn" href="/runs">Clear filter</a><% } %>
</div>
<table>
  <thead>
    <tr><th>Job</th><th>Trigger</th><th>Started</th><th>Finished</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% runs.forEach(function(r) { %>
    <tr>
      <td><%= r.job_name || r.job_id %></td>
      <td><%= r.trigger_type %></td>
      <td><%= new Date(r.started_at).toLocaleString() %></td>
      <td><%= r.finished_at ? new Date(r.finished_at).toLocaleString() : '—' %></td>
      <td><span class="status <%= r.status %>"><%= r.status %></span></td>
      <td><a class="btn small" href="/runs/<%= r.id %>">Details</a></td>
    </tr>
    <% }) %>
    <% if (!runs.length) { %>
      <tr><td colspan="6" class="muted">No runs yet.</td></tr>
    <% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
