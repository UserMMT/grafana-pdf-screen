<%- include('../partials/header', { title: 'Servers', active: 'servers', pageId: 'servers-list' }) %>
<div class="toolbar">
  <h1>Grafana Servers</h1>
  <a class="btn primary" href="/servers/new">+ Add server</a>
</div>
<table>
  <thead>
    <tr><th>Name</th><th>Base URL</th><th>Auth</th><th>Timeout</th><th></th></tr>
  </thead>
  <tbody>
    <% servers.forEach(function(s) { %>
    <tr>
      <td><%= s.name %></td>
      <td><%= s.base_url %></td>
      <td><%= s.auth_method %></td>
      <td><%= s.timeout_s %>s</td>
      <td>
        <a class="btn small" href="/servers/<%= s.id %>/edit">Edit</a>
        <form method="post" action="/servers/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('Delete server <%= s.name %>?')">
          <button class="btn small danger" type="submit">Delete</button>
        </form>
      </td>
    </tr>
    <% }) %>
    <% if (!servers.length) { %>
      <tr><td colspan="5" class="muted">No servers yet. Add one to start creating jobs.</td></tr>
    <% } %>
  </tbody>
</table>
<script>
  window.__TOUR_STEPS__ = [
    { selector: '.brand', title: 'Grafana servers', text: 'A "server" is one Grafana instance this app can talk to — its URL and credentials. Jobs and the dashboard browser both pick from here.' },
    { selector: 'a[href="/servers/new"]', title: 'Add a server', text: 'You can add as many Grafana instances as you need — each job picks which one it targets. The form has a "Test connection" button before you save.' }
  ];
</script>
<%- include('../partials/footer') %>
