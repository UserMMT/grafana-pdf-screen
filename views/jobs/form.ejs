<% const v = job || prefill || {}; %>
<%- include('../partials/header', { title: job ? 'Edit job' : 'New job', active: 'jobs', pageId: 'jobs-form' }) %>
<h1><%= job ? 'Edit job' : 'New job' %></h1>
<% if (error) { %><div class="error-box"><%= error %></div><% } %>
<% if (prefill) { %><div class="hint" style="margin-bottom:1rem">Pre-filled from the dashboard browser — review and save.</div><% } %>
<% if (!servers.length) { %>
  <div class="error-box">No Grafana servers configured yet. <a href="/servers/new">Add one first</a>.</div>
<% } else { %>
<form class="card" method="post" action="<%= job ? '/jobs/' + job.id : '/jobs' %>" id="job-form" style="max-width:760px">
  <div class="field">
    <label>Job name</label>
    <input type="text" name="name" required value="<%= v.name || '' %>">
  </div>

  <div class="field">
    <label>Grafana server</label>
    <select name="server_id" id="server_id" required>
      <% servers.forEach(function(s) { %>
        <option value="<%= s.id %>" <%= v.server_id && String(v.server_id) === String(s.id) ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>

  <div class="field">
    <label>Dashboard</label>
    <input type="text" id="dashboard_search" placeholder="Search dashboards by title...">
    <select id="dashboard_select" size="6" style="margin-top:0.4rem"></select>
    <input type="hidden" name="dashboard_uid" id="dashboard_uid" value="<%= v.dashboard_uid || '' %>">
    <input type="hidden" name="dashboard_path" id="dashboard_path" value="<%= v.dashboard_path || '' %>">
    <div class="hint">Currently selected: <span id="dashboard_selected_label"><%= v.dashboard_uid || 'none' %></span></div>
  </div>

  <div class="field">
    <label>Panel (required for CSV output; leave blank for whole-dashboard PDF only)</label>
    <select id="panel_select">
      <option value="">— whole dashboard —</option>
    </select>
    <input type="hidden" name="panel_id" id="panel_id" value="<%= v.panel_id || '' %>">
    <input type="hidden" name="panel_title" id="panel_title" value="<%= v.panel_title || '' %>">
  </div>

  <div class="field">
    <label>Variables</label>
    <div id="variables_container" class="hint">Select a dashboard to load its template variables.</div>
    <input type="hidden" name="variables_json" id="variables_json" value='<%- v.variables_json || "{}" %>'>

    <div style="margin-top:0.6rem">
      <label style="font-weight:400; font-size:0.8rem">Or paste a Grafana dashboard URL with variables already set</label>
      <div style="display:flex; gap:0.5rem">
        <input type="text" id="variables_url_paste" placeholder="https://.../d/uid/slug?var-datacenter=eu&var-server=web-1&...">
        <button type="button" class="btn small" id="variables_url_apply">Apply</button>
      </div>
      <div class="hint">Useful when variables are chained/dependent on each other — pick the values in Grafana itself (where cascading works correctly), then copy the resulting URL from your browser's address bar here.</div>
      <div class="hint" id="variables_url_status"></div>
    </div>
  </div>

  <div class="field">
    <label>Outputs</label>
    <div class="outputs-checks">
      <label class="checkbox-row"><input type="checkbox" name="output_pdf" <%= !v.outputs || JSON.parse(v.outputs).includes('pdf') ? 'checked' : '' %>> PDF</label>
      <label class="checkbox-row"><input type="checkbox" name="output_csv" <%= v.outputs && JSON.parse(v.outputs).includes('csv') ? 'checked' : '' %>> CSV (requires panel selected above)</label>
    </div>
  </div>

  <div class="field">
    <label>Cron schedule</label>
    <div class="cron-presets">
      <button type="button" class="btn small" data-cron="*/5 * * * *">Every 5 min</button>
      <button type="button" class="btn small" data-cron="0 * * * *">Hourly</button>
      <button type="button" class="btn small" data-cron="0 8 * * *">Daily 08:00</button>
      <button type="button" class="btn small" data-cron="0 8 * * 1-5">Weekdays 08:00</button>
      <button type="button" class="btn small" data-cron="0 8 * * 1">Weekly (Mon 08:00)</button>
    </div>
    <input type="text" name="cron_expression" id="cron_expression" required placeholder="0 8 * * *" value="<%= v.cron_expression || '0 8 * * *' %>">
    <div class="hint">Standard 5-field cron (minute hour day month weekday).</div>
    <div class="hint" id="cron_preview">—</div>
  </div>

  <div class="field checkbox-row">
    <input type="checkbox" name="enabled" id="enabled" <%= v.enabled === undefined || v.enabled ? 'checked' : '' %>>
    <label for="enabled">Enabled</label>
  </div>

  <div class="field checkbox-row">
    <input type="checkbox" name="save_local" id="save_local" <%= v.save_local ? 'checked' : '' %>>
    <label for="save_local">Save output to disk (otherwise ephemeral in tmp/)</label>
  </div>
  <div class="field">
    <label>Save path (optional, supports {dashboard} {panel} {date} tokens)</label>
    <input type="text" name="save_path" placeholder="{dashboard}/{date}" value="<%= v.save_path || '' %>">
    <div class="hint">Relative to the output root (<code>OUTPUT_ROOT</code> in <code>.env</code>, default <code>./data/output</code>). Leave blank to save directly under the output root. Use an absolute path to bypass the root entirely.</div>
  </div>

  <div class="field">
    <label>PDF page sizing</label>
    <select name="page_size_mode" id="page_size_mode">
      <option value="auto-fit-content" <%= !v.page_size_mode || v.page_size_mode === 'auto-fit-content' ? 'selected' : '' %>>Auto-fit content (measures dashboard height)</option>
      <option value="fixed-format" <%= v.page_size_mode === 'fixed-format' ? 'selected' : '' %>>Fixed paper format</option>
    </select>
  </div>
  <div class="field" id="pdf_format_field">
    <label>PDF format</label>
    <select name="pdf_format">
      <% ['A4','A3','Letter','Legal','Tabloid'].forEach(function(f) { %>
        <option value="<%= f %>" <%= v.pdf_format === f ? 'selected' : '' %>><%= f %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label>PDF width override (px, blank = server default)</label>
    <input type="number" name="pdf_width" value="<%= v.pdf_width || '' %>">
  </div>

  <div class="field">
    <label>Time range override (optional, e.g. now-24h / now)</label>
    <div style="display:flex; gap:0.5rem">
      <input type="text" name="time_from" placeholder="now-24h" value="<%= v.time_from || '' %>">
      <input type="text" name="time_to" placeholder="now" value="<%= v.time_to || '' %>">
    </div>
  </div>

  <button class="btn primary" type="submit">Save job</button>
  <a class="btn" href="/jobs">Cancel</a>
</form>

<% if (job) { %>
<div class="card" id="webhook-section" style="max-width:760px; margin-top:1rem">
  <label>Webhook trigger URL</label>
  <div class="hint">POST to this URL (no body needed) to trigger this job on demand, in addition to its cron schedule. The token is the only auth — treat it like a secret.</div>
  <div style="display:flex; gap:0.5rem; margin-top:0.4rem">
    <input type="text" readonly value="<%= (typeof origin !== 'undefined' ? origin : '') %>/webhooks/<%= job.webhook_token %>" onclick="this.select()" style="flex:1; padding:0.45rem 0.6rem; border:1px solid #ccc; border-radius:4px; font-size:0.85rem">
    <form method="post" action="/jobs/<%= job.id %>/webhook-token/regenerate" onsubmit="return confirm('Regenerate the webhook token? The old URL will stop working immediately.')">
      <button class="btn small" type="submit">Regenerate</button>
    </form>
  </div>
</div>
<% } %>

<script>
  window.__JOB_FORM__ = <%- JSON.stringify(v) %>;
</script>
<script src="/js/job-form.js"></script>
<script>
  window.__TOUR_STEPS__ = [
    { selector: '#server_id', title: 'Pick a Grafana server', text: 'Choose which configured Grafana server this job targets.' },
    { selector: '#dashboard_search', title: 'Find the dashboard', text: 'Search dashboards on that server by title — this calls Grafana\'s own search API live.' },
    { selector: '#panel_select', title: 'Whole dashboard or one panel?', text: 'Leave this on "whole dashboard" for a PDF-only job, or pick a specific panel if you also want its data as CSV.' },
    { selector: '#variables_container', title: 'Template variables', text: 'If the dashboard has template variables, set the specific combination this job should render (e.g. a particular server or environment).' },
    { selector: '.outputs-checks', title: 'Choose outputs', text: 'PDF renders a screenshot via headless Chrome. CSV pulls the panel\'s data directly through Grafana\'s query API (not screen-scraping) — it needs a panel selected above.' },
    { selector: '.cron-presets', title: 'Schedule it', text: 'Use a preset or type a cron expression — the line below updates live with the next 3 run times so you can sanity-check it before saving.' },
    { selector: '#save_local', title: 'Where outputs go', text: 'Off by default (files land in a temporary folder). Turn this on to keep outputs permanently, with optional {dashboard}/{panel}/{date} folder tokens.' }<%- job ? ",\n    { selector: '#webhook-section', title: 'Webhook trigger', text: 'Every saved job gets a unique webhook URL — POST to it to trigger a run on demand, independent of the cron schedule. Regenerate the token any time to revoke the old URL.' }" : '' %>
  ];
</script>
<% } %>
<%- include('../partials/footer') %>
