<%- include('../partials/header', { title: job.name, active: 'jobs' }) %>
<div class="toolbar">
  <h1><%= job.name %> <span class="enabled-badge <%= job.enabled ? 'on' : '' %>"><%= job.enabled ? 'enabled' : 'disabled' %></span></h1>
  <div>
    <form method="post" action="/jobs/<%= job.id %>/run-now" style="display:inline">
      <button class="btn primary" type="submit">Run now</button>
    </form>
    <a class="btn" href="/jobs/<%= job.id %>/edit">Edit</a>
    <a class="btn" href="/runs?job=<%= job.id %>">Full run history</a>
  </div>
</div>

<div class="card" style="max-width:760px">
  <p><strong>Server:</strong> <%= server ? server.name : job.server_id %></p>
  <p><strong>Dashboard:</strong> <%= job.dashboard_uid %> <% if (job.dashboard_path) { %>(<code><%= job.dashboard_path %></code>)<% } %></p>
  <% if (job.panel_id) { %><p><strong>Panel:</strong> <%= job.panel_title || job.panel_id %></p><% } %>
  <p><strong>Outputs:</strong> <%= JSON.parse(job.outputs).join(' + ') %></p>
  <p><strong>Variables:</strong> <code><%= job.variables_json %></code></p>
  <p><strong>Schedule:</strong> <code><%= job.cron_expression %></code>
    <% if (job.nextRun) { %> — next run <%= new Date(job.nextRun).toLocaleString() %><% } else { %> — not scheduled<% } %>
  </p>
  <p><strong>Save to disk:</strong> <%= job.save_local ? (job.save_path || '(output root)') : 'no (ephemeral)' %></p>
  <p><strong>PDF sizing:</strong> <%= job.page_size_mode %><% if (job.page_size_mode === 'fixed-format') { %> (<%= job.pdf_format %>)<% } %></p>
</div>

<h3 style="margin-top:1.5rem">Recent runs</h3>
<table>
  <thead><tr><th>Trigger</th><th>Started</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% runs.forEach(function(r) { %>
    <tr>
      <td><%= r.trigger_type %></td>
      <td><%= new Date(r.started_at).toLocaleString() %></td>
      <td><span class="status <%= r.status %>"><%= r.status %></span></td>
      <td><a class="btn small" href="/runs/<%= r.id %>">Details</a></td>
    </tr>
    <% }) %>
    <% if (!runs.length) { %><tr><td colspan="4" class="muted">No runs yet.</td></tr><% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
