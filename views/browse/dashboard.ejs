<%
function crumbsUrl(list) { return '/browse/' + server.id + (list.length ? '?crumbs=' + encodeURIComponent(JSON.stringify(list)) : ''); }
function jobUrl(panel) {
  var params = new URLSearchParams({
    server_id: server.id,
    dashboard_uid: dashboardUid,
    dashboard_path: dashboardPath || ('/d/' + dashboardUid),
  });
  if (panel) { params.set('panel_id', panel.id); params.set('panel_title', panel.title); }
  return '/jobs/new?' + params.toString();
}
%>
<%- include('../partials/header', { title: dashboard ? dashboard.title : 'Dashboard', active: 'browse', pageId: 'browse-dashboard' }) %>
<div class="toolbar">
  <h1>
    <a href="<%= crumbsUrl([]) %>">Browse</a> / <a href="<%= crumbsUrl(crumbs) %>"><%= server.name %></a>
    <% crumbs.forEach(function(c, i) { %> / <a href="<%= crumbsUrl(crumbs.slice(0, i + 1)) %>"><%= c.title %></a><% }) %>
    <% if (dashboard) { %> / <%= dashboard.title %><% } %>
  </h1>
  <% if (dashboard) { %>
    <div>
      <a class="btn primary" href="<%= jobUrl(null) %>">Create job for whole dashboard</a>
      <a class="btn" href="/browse/<%= server.id %>/dashboard/<%= dashboardUid %>/download-all-csv">⬇ Download all panel CSVs (.zip)</a>
    </div>
  <% } %>
</div>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<% if (dashboard) { %>
<div class="panel-grid">
  <% panels.forEach(function(p) { %>
  <div class="panel-card">
    <div class="panel-thumb">
      <img src="/browse/<%= server.id %>/render/<%= dashboardUid %>/<%= p.id %>?slug=<%= encodeURIComponent(slug) %>&w=320&h=180"
           alt="<%= p.title %>"
           onerror="this.replaceWith(Object.assign(document.createElement('div'), {className:'panel-thumb-fallback', textContent:'No preview'}))">
    </div>
    <div class="panel-card-body">
      <strong><%= p.title || '(untitled panel)' %></strong>
      <div class="hint"><%= p.type %><% if (p.datasourceType) { %> · <%= p.datasourceType %><% } %><% if (!p.hasData) { %> · no data query<% } %></div>
      <% if (p.hasData) { %>
        <a class="btn small" href="<%= jobUrl(p) %>">Create job for this panel</a>
      <% } %>
    </div>
  </div>
  <% }) %>
  <% if (!panels.length) { %><p class="muted">This dashboard has no panels.</p><% } %>
</div>
<script>
  window.__TOUR_STEPS__ = [
    { selector: '.panel-grid', title: 'Every panel on this dashboard', text: 'Including text/markdown panels — thumbnails are rendered server-side via Grafana\'s image renderer, so your credentials never reach the browser. "No preview" just means rendering isn\'t available for that panel right now.' },
    { selector: '.panel-card', title: 'Create a job from here', text: 'Panels with a data query get a "Create job for this panel" link (for CSV export). Use the button at the top for a whole-dashboard PDF instead. Either way it takes you to a pre-filled job form.' },
    { selector: '.toolbar a[href*="download-all-csv"]', title: 'Or just grab everything right now', text: 'This is a one-off, unscheduled export — every data panel\'s current data queried live and zipped up, no job needed.' }
  ];
</script>
<% } %>
<%- include('../partials/footer') %>
